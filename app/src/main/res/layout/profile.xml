<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Back -->

        <LinearLayout
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_arrow_back"
                android:contentDescription="@string/back"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:text="@string/back"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"/>

        </LinearLayout>

        <TextView
            style="@style/ScreenTitle"
            android:layout_marginTop="20dp"
            android:text="@string/profile"/>

        <TextView
            style="@style/ScreenSubtitle"
            android:text="@string/profile_subtitle"/>

        <!-- Who is signed in -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="15dp"
            android:background="@drawable/card_background">

            <TextView
                android:id="@+id/profileInitials"
                style="@style/Avatar"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/profileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"/>

                <TextView
                    android:id="@+id/profileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary"/>

                <TextView
                    android:id="@+id/profileSignInMethod"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/green_text"
                    android:background="@drawable/bg_role_green"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Details -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/card_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="@string/first_name"/>

                    <EditText
                        android:id="@+id/profileFirstName"
                        style="@style/SmallInput"
                        android:layout_marginTop="5dp"
                        android:hint="@string/first_name_hint"
                        android:inputType="textPersonName|textCapWords"/>

                </LinearLayout>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="@string/surname"/>

                    <EditText
                        android:id="@+id/profileSurname"
                        style="@style/SmallInput"
                        android:layout_marginTop="5dp"
                        android:hint="@string/surname"
                        android:inputType="textPersonName|textCapWords"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/FieldLabel"
                android:layout_marginTop="13dp"
                android:text="@string/phone_number"/>

            <EditText
                android:id="@+id/profilePhone"
                style="@style/Input"
                android:layout_marginTop="5dp"
                android:hint="+27 082828282"
                android:inputType="phone"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="@string/room_number"/>

                    <EditText
                        android:id="@+id/profileRoom"
                        style="@style/SmallInput"
                        android:layout_marginTop="5dp"
                        android:hint="B-204"
                        android:inputType="textCapCharacters"/>

                </LinearLayout>

                <Space
                    android:layout_width="8dp"
                    android:layout_height="1dp"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/FieldLabel"
                        android:text="@string/building"/>

                    <EditText
                        android:id="@+id/profileBuilding"
                        style="@style/SmallInput"
                        android:layout_marginTop="5dp"
                        android:hint="Rise"
                        android:inputType="textCapWords"/>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/saveProfileButton"
                style="@style/PrimaryButton"
                android:layout_marginTop="18dp"
                android:text="@string/save_changes"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
