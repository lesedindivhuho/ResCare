<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FCF9F6">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Staff Directory"
                    android:textColor="#202020"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Contact your accommodation team"
                    android:textColor="#999999"
                    android:textSize="9sp" />

            </LinearLayout>
        </LinearLayout>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:hint="⌕  Search by name or role"
            android:textSize="10sp"
            android:paddingStart="12dp"
            android:singleLine="true"
            android:background="@drawable/bg_search"
            android:layout_marginTop="12dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="25dp"
                    android:text="All"
                    android:gravity="center"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:background="@drawable/bg_filter_selected" />

                <TextView
                    android:layout_width="65dp"
                    android:layout_height="25dp"
                    android:text="Caretaker"
                    android:gravity="center"
                    android:textSize="8sp"
                    android:textColor="#777777" />

                <TextView
                    android:layout_width="60dp"
                    android:layout_height="25dp"
                    android:text="Laundry"
                    android:gravity="center"
                    android:textSize="8sp"
                    android:textColor="#777777" />

                <TextView
                    android:layout_width="75dp"
                    android:layout_height="25dp"
                    android:text="Maintenance"
                    android:gravity="center"
                    android:textSize="8sp"
                    android:textColor="#777777" />

                <TextView
                    android:layout_width="55dp"
                    android:layout_height="25dp"
                    android:text="Security"
                    android:gravity="center"
                    android:textSize="8sp"
                    android:textColor="#777777" />

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp">

            <!-- Staff Card 1 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_staff_card"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="9dp">
<!--Thabo mokoena-->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mr. Thabo Mokoena"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Caretaker"
                            android:textColor="#008E6A"
                            android:textSize="7sp"
                            android:padding="4dp"
                            android:background="@drawable/bg_role_green" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:text="◷  Mon – Fri, 07:00 – 17:00"
                    android:textSize="8sp"
                    android:textColor="#777777"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:background="@drawable/bg_info"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="⌕  0822222564"
                    android:textSize="8sp"
                    android:textColor="#777777"
                    android:gravity="center_vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="✉  caretaker@sunnyvale.example"
                    android:textSize="8sp"
                    android:textColor="#777777"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <!--Ms priya naidoo-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_staff_card"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ms. Priya Naidoo"
                            android:textStyle="bold"
                            android:textColor="#333333"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Laundry Staff"
                            android:textColor="#008E6A"
                            android:textSize="7sp"
                            android:padding="4dp"
                            android:background="@drawable/bg_role_green" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:text="◷  Daily, 08:00 – 16:00"
                    android:textSize="8sp"
                    android:textColor="#777777"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:background="@drawable/bg_info"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="0823456789"
                    android:textSize="8sp"
                    android:textColor="#777777"
                    android:gravity="center_vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="✉  laundry@sunnyvale.example"
                    android:textSize="8sp"
                    android:textColor="#777777"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <!-- Dvaid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_staff_card"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  Mr. David van Wyk"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Maintenance"
                    android:textColor="#008E6A"
                    android:textSize="7sp"
                    android:padding="4dp"
                    android:background="@drawable/bg_role_green"
                    android:layout_marginTop="3dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:text="◷  Mon – Sat, 08:00 – 18:00"
                    android:textSize="8sp"
                    android:textColor="#777777"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:background="@drawable/bg_info"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="0826756756"
                    android:textSize="8sp"
                    android:textColor="#777777"
                    android:gravity="center_vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="✉  maintenance@sunnyvale.example"
                    android:textSize="8sp"
                    android:textColor="#777777"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <!-- Learto -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_staff_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▢  Ms. Lerato Khumalo"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Security"
                    android:textColor="#A46B00"
                    android:textSize="7sp"
                    android:padding="4dp"
                    android:background="@drawable/bg_role_orange"
                    android:layout_marginTop="3dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:text="◷  24 / 7"
                    android:textSize="8sp"
                    android:textColor="#777777"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:background="@drawable/bg_info"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="0765433454"
                    android:textSize="8sp"
                    android:textColor="#777777"
                    android:gravity="center_vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="✉  security@sunnyvale.example"
                    android:textSize="8sp"
                    android:textColor="#777777"
                    android:gravity="center_vertical" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- navigation at the bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="5dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="⌂\nHome"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="#999999" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Laundry"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="#999999" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Maintenance"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="#999999" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Staff"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="#00B878"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Emergency"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="#999999" />
        <TextView
            android:id="@+id/laundryNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Laundry"
            android:textSize="8sp"
            android:textColor="#999999" />
    </LinearLayout>

</LinearLayout>