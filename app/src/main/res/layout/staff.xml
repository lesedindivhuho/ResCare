<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/staff_directory"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/staff_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="9sp" />

            </LinearLayout>
        </LinearLayout>

        <EditText
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:hint="@string/search_staff_hint"
            android:textSize="10sp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:paddingStart="12dp"
            android:singleLine="true"
            android:background="@drawable/bg_search"
            android:layout_marginTop="12dp" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:minWidth="42dp"
                    android:layout_height="25dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/filter_all"
                    android:gravity="center"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:background="@drawable/bg_filter_selected" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/role_caretaker"
                    android:gravity="center"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/laundry"
                    android:gravity="center"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/role_maintenance"
                    android:gravity="center"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="25dp"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:text="@string/role_security"
                    android:gravity="center"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="10dp">

            <!-- Thabo Mokoena -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_staff_card"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mr. Thabo Mokoena"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/role_caretaker"
                            android:textColor="@color/green_text"
                            android:textSize="7sp"
                            android:padding="4dp"
                            android:background="@drawable/bg_role_green" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:text="@string/hours_mon_fri"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:background="@drawable/bg_info"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="⌕  0822222564"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="✉  caretaker@sunnyvale.example"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <!-- Priya Naidoo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_staff_card"
                android:layout_marginBottom="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="9dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ms. Priya Naidoo"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:textSize="10sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/role_laundry_staff"
                            android:textColor="@color/green_text"
                            android:textSize="7sp"
                            android:padding="4dp"
                            android:background="@drawable/bg_role_green" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:text="@string/hours_daily"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:background="@drawable/bg_info"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="0823456789"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="✉  laundry@sunnyvale.example"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <!-- David van Wyk -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_staff_card"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="  Mr. David van Wyk"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/role_maintenance"
                    android:textColor="@color/green_text"
                    android:textSize="7sp"
                    android:padding="4dp"
                    android:background="@drawable/bg_role_green"
                    android:layout_marginTop="3dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:text="@string/hours_mon_sat"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:background="@drawable/bg_info"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="0826756756"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="✉  maintenance@sunnyvale.example"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical" />

            </LinearLayout>

            <!-- Lerato Khumalo -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@drawable/bg_staff_card">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▢  Ms. Lerato Khumalo"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/role_security"
                    android:textColor="@color/orange_text"
                    android:textSize="7sp"
                    android:padding="4dp"
                    android:background="@drawable/bg_role_orange"
                    android:layout_marginTop="3dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="28dp"
                    android:text="@string/hours_always"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:background="@drawable/bg_info"
                    android:layout_marginTop="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="0765433454"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="27dp"
                    android:text="✉  security@sunnyvale.example"
                    android:textSize="8sp"
                    android:textColor="@color/text_secondary"
                    android:gravity="center_vertical" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- navigation at the bottom -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@color/surface"
        android:elevation="5dp">

        <TextView
            android:id="@+id/homeNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/nav_home"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:id="@+id/laundryNav"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/laundry"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/role_maintenance"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="@color/text_secondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/nav_staff"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="@color/green"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="@string/nav_emergency"
            android:gravity="center"
            android:textSize="8sp"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

</LinearLayout>
